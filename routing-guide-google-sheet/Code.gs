const RAW_HEADERS = ['Timestamp','Participant','Question ID','Section','Event','Question','Decision','Final Fee/Rule','Reason/Caveat','Owner','Evidence Required','Source','Updated At'];
const QUESTION_HEADERS = ['ID','Section','Event','Question','Current Rule/Fee','Benchmark/Research','Recommended Default','Proposed Fee/Rule','Default Owner','Evidence Required','SLA Impact','Unit','Notes'];

function doGet(e) {
  setupWorkbook();
  return ContentService.createTextOutput(JSON.stringify({ok:true,message:'Atomix Routing Guide receiver ready',questions:QUESTIONS.length})).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    const payload = JSON.parse(e.postData.contents || '{}');
    if (payload.passcode !== SHEET_PASSCODE) throw new Error('Bad passcode');
    setupWorkbook();
    const ss = SpreadsheetApp.getActive();
    const raw = ss.getSheetByName('Raw Answers');
    const answers = payload.answers || {};
    const participant = payload.participant || 'Unknown';
    const now = new Date();
    const rows = [];
    QUESTIONS.forEach(q => {
      const a = answers[q.id] || {};
      if (a.decision || a.fee || a.reason || a.owner || a.evidence) {
        rows.push([now, participant, q.id, q.section, q.event, q.question, a.decision || '', a.fee || '', a.reason || '', a.owner || '', a.evidence || '', payload.source || 'github-page', a.updatedAt || '']);
      }
    });
    if (rows.length) raw.getRange(raw.getLastRow()+1,1,rows.length,RAW_HEADERS.length).setValues(rows);
    rebuildCompiledTabs();
    return ContentService.createTextOutput(JSON.stringify({ok:true,received:rows.length,participant})).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message || err)})).setMimeType(ContentService.MimeType.JSON);
  }
}

function setupWorkbook() {
  const ss = SpreadsheetApp.getActive();
  ensureSheet('Question Bank', QUESTION_HEADERS);
  ensureSheet('Raw Answers', RAW_HEADERS);
  ensureSheet('Compiled Summary', ['Metric','Value']);
  ensureSheet('Conflicts', ['Question ID','Section','Event','Question','Decisions','Participants','Answer Detail']);
  ensureSheet('Consensus Ready', ['Question ID','Section','Event','Question','Consensus Decision','Fee/Rule Notes','Owner','Evidence Required']);
  ensureSheet('Unanswered', ['Participant','Question ID','Section','Event','Question']);
  const qb = ss.getSheetByName('Question Bank');
  if (qb.getLastRow() <= 1) {
    const values = QUESTIONS.map(q => [q.id,q.section,q.event,q.question,q.current||'',q.benchmark||'',q.recommended||'',q.proposed||'',q.owner||'',q.evidence||'',q.sla||'',q.unit||'',q.notes||'']);
    qb.getRange(2,1,values.length,QUESTION_HEADERS.length).setValues(values);
    qb.autoResizeColumns(1, QUESTION_HEADERS.length);
  }
}

function ensureSheet(name, headers) {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (sh.getLastRow() === 0) sh.appendRow(headers);
  const first = sh.getRange(1,1,1,headers.length).getValues()[0];
  if (first.join('|') !== headers.join('|')) {
    sh.clear(); sh.appendRow(headers);
  }
  sh.setFrozenRows(1);
  return sh;
}

function rebuildCompiledTabs() {
  const ss = SpreadsheetApp.getActive();
  const raw = ss.getSheetByName('Raw Answers');
  const rawValues = raw.getDataRange().getValues();
  const entries = rawValues.slice(1).filter(r => r[1] && r[2]);
  const people = [...new Set(entries.map(r => r[1]))];
  const latest = {};
  entries.forEach(r => { latest[r[1]+'|'+r[2]] = r; });

  const summary = ss.getSheetByName('Compiled Summary');
  resetWithHeaders(summary, ['Metric','Value']);
  summary.getRange(2,1,6+people.length,2).setValues([
    ['Total questions', QUESTIONS.length],
    ['Participants submitted', people.length],
    ['Raw answer rows', entries.length],
    ['Consensus ready', countConsensus(latest, people)],
    ['Conflicts', buildConflictRows(latest, people).length],
    ['Fully unanswered participant/questions', buildUnansweredRows(latest, people).length],
    ...people.map(p => [p+' answered', QUESTIONS.filter(q => latest[p+'|'+q.id]).length+'/'+QUESTIONS.length])
  ]);

  const conflicts = ss.getSheetByName('Conflicts');
  resetWithHeaders(conflicts, ['Question ID','Section','Event','Question','Decisions','Participants','Answer Detail']);
  const conflictRows = buildConflictRows(latest, people);
  if (conflictRows.length) conflicts.getRange(2,1,conflictRows.length,7).setValues(conflictRows);

  const consensus = ss.getSheetByName('Consensus Ready');
  resetWithHeaders(consensus, ['Question ID','Section','Event','Question','Consensus Decision','Fee/Rule Notes','Owner','Evidence Required']);
  const consensusRows = buildConsensusRows(latest, people);
  if (consensusRows.length) consensus.getRange(2,1,consensusRows.length,8).setValues(consensusRows);

  const unanswered = ss.getSheetByName('Unanswered');
  resetWithHeaders(unanswered, ['Participant','Question ID','Section','Event','Question']);
  const unansweredRows = buildUnansweredRows(latest, people);
  if (unansweredRows.length) unanswered.getRange(2,1,unansweredRows.length,5).setValues(unansweredRows);
}

function resetWithHeaders(sh, headers) { sh.clear(); sh.appendRow(headers); sh.setFrozenRows(1); }
function answersForQuestion(latest, people, q) { return people.map(p => latest[p+'|'+q.id]).filter(Boolean); }
function decisions(rows) { return rows.map(r => String(r[6]||'')).filter(Boolean); }
function countConsensus(latest, people) { return buildConsensusRows(latest, people).length; }
function buildConflictRows(latest, people) {
  return QUESTIONS.map(q => {
    const rows = answersForQuestion(latest, people, q); const ds = decisions(rows); const unique = [...new Set(ds)];
    if (unique.length <= 1) return null;
    return [q.id,q.section,q.event,q.question,unique.join(' | '),rows.map(r=>r[1]).join(' | '),rows.map(r=>r[1]+': '+r[6]+' / '+(r[7]||'')).join('\n')];
  }).filter(Boolean);
}
function buildConsensusRows(latest, people) {
  return QUESTIONS.map(q => {
    const rows = answersForQuestion(latest, people, q); const ds = decisions(rows); const unique = [...new Set(ds)];
    if (!ds.length || unique.length !== 1) return null;
    return [q.id,q.section,q.event,q.question,unique[0],rows.map(r=>r[7]).filter(Boolean).join(' | '),rows.map(r=>r[9]).filter(Boolean).join(' | '),rows.map(r=>r[10]).filter(Boolean).join(' | ')];
  }).filter(Boolean);
}
function buildUnansweredRows(latest, people) {
  const p = people.length ? people : ['Pat','Norman','Kayla','Hunter'];
  const out=[]; p.forEach(person => QUESTIONS.forEach(q => { if (!latest[person+'|'+q.id]) out.push([person,q.id,q.section,q.event,q.question]); }));
  return out;
}

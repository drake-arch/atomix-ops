*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Inter,Arial,sans-serif;color:var(--ink)}
.top{height:64px;background:#fff;border-bottom:1px solid var(--line);box-shadow:0 2px 7px rgba(0,0,0,.12);display:flex;align-items:center;justify-content:space-between;padding:0 36px;position:sticky;top:0;z-index:5}.brand{display:flex;align-items:center;gap:12px}.mark{width:38px;height:38px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-weight:900}.brand h1{font-size:20px;line-height:1;margin:0;color:var(--green)}.brand p{margin:3px 0 0;color:var(--muted);font-size:12px}.date{font-size:14px;font-weight:700}.wrap{width:min(100% - 32px,1580px);margin:28px auto 64px}.hero{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:26px 28px;margin-bottom:18px}.eyebrow{font-size:13px;font-weight:800;color:var(--green);letter-spacing:.08em;text-transform:uppercase}.hero h2{font-size:38px;margin:8px 0 6px;letter-spacing:-.04em}.hero p{font-size:18px;line-height:1.5;color:var(--text);margin:0}.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:22px;margin-bottom:18px}.card h3{font-size:22px;margin:0 0 14px}.good{background:var(--pale);border-color:#b9dfc7}.good ul,.card ul{margin:0;padding-left:22px}.good li,.card li{font-size:17px;line-height:1.55;margin:7px 0}.takeaway{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.takeaway div{background:#fbfbfb;border:1px solid var(--line);border-radius:12px;padding:16px}.takeaway strong{display:block;color:var(--green);font-size:15px;margin-bottom:5px}.takeaway span{color:var(--text);font-size:15px;line-height:1.45}.comic{width:100%;border-radius:12px;border:1px solid var(--line);display:block}.agenda li{padding:10px 0;border-bottom:1px solid var(--line)}.agenda li:last-child{border-bottom:0}.note{background:#fbfbfb;border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin:10px 0;color:var(--text);font-size:15px;line-
    "orders_sql": "SELECT\n  DATE(o.shipDate) AS ship_date,\n  o.warehouseId AS warehouse_id,\n  w.name AS warehouse_name,\n  COUNT(*) AS orders_shipped\nFROM Orders o\nLEFT JOIN Warehouses w ON w.id = o.warehouseId\nWHERE o.isDeleted = 0\n  AND o.isArchived = 0\n  AND o.orderStatus = 'shipped'\n  AND o.shipDate >= '2026-07-12'\n  AND o.shipDate < '2026-08-12'\nGROUP BY DATE(o.shipDate), o.warehouseId, w.name\nORDER BY ship_date, warehouse_name",
